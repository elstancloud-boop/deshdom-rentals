{
  "name": "rentora",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
