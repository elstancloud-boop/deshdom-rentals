# Copy to .env.local and fill in.
APP_URL=http://localhost:3000
DATABASE_PATH=./data/deshdom.db
# 32+ random chars. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
# Optional. Without Stripe keys the store runs in DEMO payment mode (no real charges).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Seed admin (used by `npm run db:seed`)
ADMIN_EMAIL=admin@deshdom.test
ADMIN_PASSWORD=change-me-long-and-random
